#!/bin/sh
set -e

cat > /etc/os-release << 'EOF'
NAME="Medula Linux"
VERSION="1.0"
ID=medula
ID_LIKE=ubuntu
PRETTY_NAME="Medula Linux 1.0"
VERSION_ID="1.0"
HOME_URL="https://medula-linux.github.io"
SUPPORT_URL="https://github.com/medula-linux/medula-linux"
BUG_REPORT_URL="https://github.com/medula-linux/medula-linux/issues"
EOF

echo "Medula Linux \n \l" > /etc/issue
echo "Medula Linux" > /etc/issue.net
